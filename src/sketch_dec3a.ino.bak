const char* WIFI_PASS     = "YOUR_WIFI_PASS";

// API Keys
const char* ELEVEN_LABS_API_KEY = "YOUR_ELEVEN_LABS_KEY";
const char* GEMINI_API_KEY      = "YOUR_GEMINI_API_KEY";

// API Endpoints
const char* EL_API_URL = "https://api.elevenlabs.io/v1/speech-to-text";
const char* GEMINI_TEXT_URL = "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=";
const char* GEMINI_IMAGE_URL = "https://generativelanguage.googleapis.com/v1alpha/models/gemini-3-pro-image-preview:generateContent?key=";

// Hardware Config
#define RECORD_SAMPLE_RATE 16000
#define RECORD_BIT_DEPTH   16
#define RX_BUFFER_SIZE     1024

// UI Config
#define MAX_FILES_LIST     5
#define LINES_PER_PAGE     15

// ============================================================================
// DATA STRUCTURES
// ============================================================================
struct AudioFile {
    String filename;
    String dateTime;
};

struct SummaryFile {
    String filename;
    String relatedAudioFilename;
    String dateTime;
};

struct ImageFile {
    String originalFilename;
    String ditheredFilename; // We will use this to store the path to the dithered version (or just raw bin)
    String summaryFilename;
    String dateTime;
};

enum AppState {
    STATE_MENU,
    STATE_RECORDING,
    STATE_PLAYBACK,
    STATE_LIST_AUDIO,
    STATE_LIST_SUMMARIES,
    STATE_VIEW_SUMMARY,
    STATE_GALLERY,
    STATE_VIEW_IMAGE,
    STATE_PROCESSING
};

// ============================================================================
// GLOBALS
// ============================================================================
AppState currentState = STATE_MENU;
File fileObj;
String currentTextContent = "";
int currentPage = 0;
String currentImageFile = "";

// Lists
std::vector<AudioFile> recentAudio;
std::vector<SummaryFile> recentSummaries;
std::vector<ImageFile> recentImages;

// Recording State
bool isRecording = false;
uint32_t recordStartTime = 0;

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

void logError(String msg) {
    Serial.println("[ERROR] " + msg);
    M5.Display.startWrite();
    M5.Display.fillWindow(TFT_WHITE);
    M5.Display.setTextColor(TFT_RED, TFT_WHITE);
    M5.Display.setTextSize(2);
    M5.Display.setCursor(10, 50);
    M5.Display.println("Error:");
    M5.Display.setCursor(10, 80);
    M5.Display.println(msg);
    M5.Display.endWrite();
    delay(2000); // Give user time to see
}

String getTimestamp() {
    // In a real app, sync NTP. Here we simulate or use millis for uniqueness if not synced.
    // For simplicity, we use a basic counter + millis if NTP isn't set up.
    // Ideally use struct tm with getLocalTime().
    unsigned long now = millis();
    return String(now);
}

// scan SD for files and populate vectors (Simplified for recent 5)
void scanFiles() {
    recentAudio.clear();
    recentSummaries.clear();
    recentImages.clear();
    
    File root = SD.open("/");
    if(!root){ Serial.println("Failed to open directory"); return; }
    
    File file = root.openNextFile();
    while(file){
        String fn = String(file.name());
        if(fn.endsWith(".wav")) {
            if(recentAudio.size() < MAX_FILES_LIST) recentAudio.insert(recentAudio.begin(), {fn, "Today"}); 
        } else if (fn.endsWith(".txt")) {
            if(recentSummaries.size() < MAX_FILES_LIST) recentSummaries.insert(recentSummaries.begin(), {fn, "", "Today"});
        } else if (fn.endsWith(".jpg") && !fn.startsWith("._")) { // Simple filter
             if(recentImages.size() < MAX_FILES_LIST) recentImages.insert(recentImages.begin(), {fn, fn, "", "Today"});
        }
        file = root.openNextFile();
    }
    // Note: A real implementation would sort by date modified.
}

// ============================================================================
// API INTERACTIONS
// ============================================================================

// 1. Eleven Labs STT (Multipart upload is complex in C++, simplistic approach below)
String transcribeAudio(String filename) {
    // NOTE: This requires a robust Multipart implementation. 
    // For brevity/stability in this snippet, we outline the logic. 
    // Integrating a full multipart library inside a single .ino is too large.
    // We will simulate a successful return or use a basic constructed body.
    
    if(WiFi.status() != WL_CONNECTED) { logError("WiFi Disconnected"); return ""; }

    Serial.println("Transcribing: " + filename);
    
    // Read file from SD
    File audio = SD.open(filename, FILE_READ);
    if (!audio) { logError("Cannot open audio file"); return ""; }
    uint32_t fileSize = audio.size();

    String boundary = "------------------------ESP32Boundary";
    String head = "--" + boundary + "\r\nContent-Disposition: form-data; name=\"model_id\"\r\n\r\nscribe_v1\r\n";
    head += "--" + boundary + "\r\nContent-Disposition: form-data; name=\"file\"; filename=\"" + filename + "\"\r\nContent-Type: audio/wav\r\n\r\n";
    String tail = "\r\n--" + boundary + "--\r\n";

    uint32_t totalLen = head.length() + fileSize + tail.length();

    WiFiClientSecure client;
    client.setInsecure(); // Skip cert check for demo
    
    if (client.connect("api.elevenlabs.io", 443)) {
        client.println("POST /v1/speech-to-text HTTP/1.1");
        client.println("Host: api.elevenlabs.io");
        client.println("xi-api-key: " + String(ELEVEN_LABS_API_KEY));
        client.println("Content-Type: multipart/form-data; boundary=" + boundary);
        client.println("Content-Length: " + String(totalLen));
        client.println();
        client.print(head);

        // Stream file
        uint8_t buf[1024];
        while (audio.available()) {
            int r = audio.read(buf, 1024);
            client.write(buf, r);
        }
        client.print(tail);
        
        // Read Response
        String response = "";
        bool headerEnded = false;
        while(client.connected() || client.available()) {
            if (client.available()) {
                String line = client.readStringUntil('\n');
                if (line == "\r") headerEnded = true;
                if (headerEnded) response += line;
            }
        }
        audio.close();
        
        // Parse JSON
        int jsonStart = response.indexOf('{');
        int jsonEnd = response.lastIndexOf('}');
        if (jsonStart != -1 && jsonEnd != -1) {
            String jsonStr = response.substring(jsonStart, jsonEnd + 1);
            JsonDocument doc;
            deserializeJson(doc, jsonStr);
            return doc["text"].as<String>();
        }
    } else {
        logError("Connection failed");
    }
    return "";
}

// 2. Gemini Summarization
String summarizeText(String text) {
    if(WiFi.status() != WL_CONNECTED) return "No WiFi";
    
    HTTPClient http;
    String url = String(GEMINI_TEXT_URL) + GEMINI_API_KEY;
    http.begin(url);
    http.addHeader("Content-Type", "application/json");

    JsonDocument doc;
    doc["contents"][0]["parts"][0]["text"] = "Summarize this text into 5 concise bullet points: " + text;
    String payload;
    serializeJson(doc, payload);

    int httpCode = http.POST(payload);
    String summary = "";
    
    if (httpCode == 200) {
        String resp = http.getString();
        JsonDocument respDoc;
        deserializeJson(respDoc, resp);
        summary = respDoc["candidates"][0]["content"]["parts"][0]["text"].as<String>();
    } else {
        logError("Gemini Summary Error: " + String(httpCode));
    }
    http.end();
    return summary;
}

// 3. Gemini Image Gen
bool generateInfographic(String summary, String& outOriginalFilename) {
    if(WiFi.status() != WL_CONNECTED) return false;

    HTTPClient http;
    String url = String(GEMINI_IMAGE_URL) + GEMINI_API_KEY;
    http.begin(url);
    http.addHeader("Content-Type", "application/json");

    JsonDocument doc;
    // Prompt engineering for infographic
    String prompt = "Create a minimalist, high-contrast infographic poster summarizing these points. Style: Vector art, flat design, suitable for monochrome conversion. Points: " + summary;
    
    doc["contents"][0]["parts"][0]["text"] = prompt;
    doc["media_resolution"] = "MEDIA_RESOLUTION_MEDIUM"; // Optional, depending on API version
    String payload;
    serializeJson(doc, payload);

    int httpCode = http.POST(payload);
    
    if (httpCode == 200) {
        String resp = http.getString();
        JsonDocument respDoc;
        DeserializationError err = deserializeJson(respDoc, resp);
        if (err) { logError("JSON Parse Err"); return false; }
        
        // Gemini image gen usually returns base64 in inlineData
        const char* base64Img = respDoc["candidates"][0]["content"]["parts"][0]["inlineData"]["data"];
        
        if (base64Img) {
            // Decode and Save
            String ts = getTimestamp();
            outOriginalFilename = "/img_" + ts + ".jpg";
            
            File imgFile = SD.open(outOriginalFilename, FILE_WRITE);
            // Decode Base64
            // Note: Standard Base64 decode might need a buffer. 
            // We'll use a simplified block decoder here or ESP32 built-in if available.
            // For this snippet, assuming the Base64 string fits in memory (M5PaperS3 has 8MB PSRAM).
            // A safer way is streaming decode.
            
            size_t outputLen = 0;
            unsigned char* decoded = base64_decode((const unsigned char*)base64Img, strlen(base64Img), &outputLen);
            
            if (decoded) {
                imgFile.write(decoded, outputLen);
                free(decoded);
                imgFile.close();
                return true;
            }
        }
    } else {
        logError("Img Gen Err: " + String(httpCode));
    }
    http.end();
    return false;
}

// ============================================================================
// AUDIO RECORDING
// ============================================================================
void startRecording() {
    String filename = "/rec_" + getTimestamp() + ".wav";
    fileObj = SD.open(filename, FILE_WRITE);
    if(!fileObj) { logError("SD Write Error"); return; }
    
    // Write WAV Header (Placeholder, will update size later)
    uint8_t header[44];
    memset(header, 0, 44);
    fileObj.write(header, 44);
    
    M5.Speaker.end(); // Mute speaker
    M5.Mic.begin();
    isRecording = true;
    
    // Add to list
    recentAudio.insert(recentAudio.begin(), {filename, "Just now"});
    
    // UI Update
    M5.Display.fillScreen(TFT_RED);
    M5.Display.setTextColor(TFT_WHITE);
    M5.Display.drawCenterString("RECORDING...", M5.Display.width()/2, M5.Display.height()/2, &fonts::FreeSansBold24pt7b);
}

void stopRecording() {
    isRecording = false;
    M5.Mic.end();
    
    // Update WAV Header
    uint32_t fileSize = fileObj.size();
    uint32_t dataSize = fileSize - 44;
    
    fileObj.seek(0);
    uint8_t header[44];
    // RIFF
    memcpy(header, "RIFF", 4);
    uint32_t riffSize = fileSize - 8;
    memcpy(header + 4, &riffSize, 4);
    memcpy(header + 8, "WAVE", 4);
    // fmt
    memcpy(header + 12, "fmt ", 4);
    uint32_t fmtChunkSize = 16;
    memcpy(header + 16, &fmtChunkSize, 4);
    uint16_t audioFormat = 1; // PCM
    memcpy(header + 20, &audioFormat, 2);
    uint16_t numChannels = 1; // Mono
    memcpy(header + 22, &numChannels, 2);
    uint32_t sampleRate = RECORD_SAMPLE_RATE;
    memcpy(header + 24, &sampleRate, 4);
    uint32_t byteRate = RECORD_SAMPLE_RATE * 1 * (RECORD_BIT_DEPTH/8);
    memcpy(header + 28, &byteRate, 4);
    uint16_t blockAlign = 1 * (RECORD_BIT_DEPTH/8);
    memcpy(header + 32, &blockAlign, 2);
    uint16_t bitsPerSample = RECORD_BIT_DEPTH;
    memcpy(header + 34, &bitsPerSample, 2);
    // data
    memcpy(header + 36, "data", 4);
    memcpy(header + 40, &dataSize, 4);
    
    fileObj.write(header, 44);
    fileObj.close();
    
    currentState = STATE_MENU;
}

void loopRecording() {
    if(!isRecording) return;
    int16_t *buf = (int16_t *)malloc(RX_BUFFER_SIZE * sizeof(int16_t));
    if (M5.Mic.record(buf, RX_BUFFER_SIZE, RECORD_SAMPLE_RATE)) {
        fileObj.write((uint8_t*)buf, RX_BUFFER_SIZE * sizeof(int16_t));
    }
    free(buf);
}

// ============================================================================
// UI DRAWING
// ============================================================================

void drawMenu() {
    M5.Display.startWrite();
    M5.Display.fillScreen(TFT_WHITE);
    M5.Display.setTextColor(TFT_BLACK, TFT_WHITE);
    M5.Display.setTextSize(1);
    
    int btnH = 80;
    int gap = 20;
    int y = 40;
    
    // Header
    M5.Display.fillRect(0, 0, 960, 40, TFT_BLACK);
    M5.Display.setTextColor(TFT_WHITE, TFT_BLACK);
    M5.Display.drawString("MindInk - Gemini Companion", 10, 10, &fonts::FreeSansBold12pt7b);
    
    // Buttons (Simple Rectangles)
    M5.Display.setTextColor(TFT_BLACK, TFT_WHITE);
    
    // Record
    M5.Display.drawRect(50, y, 200, btnH, TFT_BLACK);
    M5.Display.drawString("RECORD", 100, y+30, &fonts::FreeSansBold12pt7b);
    
    // Audio List
    M5.Display.drawRect(50, y + btnH + gap, 200, btnH, TFT_BLACK);
    M5.Display.drawString("AUDIO FILES", 90, y + btnH + gap + 30, &fonts::FreeSansBold12pt7b);
    
    // Summaries
    M5.Display.drawRect(300, y, 200, btnH, TFT_BLACK);
    M5.Display.drawString("SUMMARIES", 330, y+30, &fonts::FreeSansBold12pt7b);
    
    // Gallery
    M5.Display.drawRect(300, y + btnH + gap, 200, btnH, TFT_BLACK);
    M5.Display.drawString("GALLERY", 350, y + btnH + gap + 30, &fonts::FreeSansBold12pt7b);

    M5.Display.endWrite();
}

void drawList(String title, const std::vector<String>& items) {
    M5.Display.fillScreen(TFT_WHITE);
    M5.Display.fillRect(0, 0, 960, 40, TFT_BLACK);
    M5.Display.setTextColor(TFT_WHITE, TFT_BLACK);
    M5.Display.drawString(title, 10, 10, &fonts::FreeSansBold12pt7b);
    
    M5.Display.setTextColor(TFT_BLACK, TFT_WHITE);
    int y = 60;
    for (int i=0; i<items.size(); i++) {
        M5.Display.drawRect(20, y, 920, 50, TFT_BLACK);
        M5.Display.drawString(items[i], 30, y+15, &fonts::FreeSans12pt7b);
        y += 60;
    }
    // Back Button
    M5.Display.fillRect(0, 500, 100, 40, TFT_LIGHTGREY);
    M5.Display.drawString("BACK", 20, 510, &fonts::FreeSans9pt7b);
}

void drawTextView(String text) {
    M5.Display.fillScreen(TFT_WHITE);
    M5.Display.fillRect(0, 0, 960, 40, TFT_BLACK);
    M5.Display.setTextColor(TFT_WHITE, TFT_BLACK);
    M5.Display.drawString("Summary View", 10, 10, &fonts::FreeSansBold12pt7b);
    
    M5.Display.setTextColor(TFT_BLACK, TFT_WHITE);
    M5.Display.setCursor(10, 60);
    // Simple wrapping text draw
    M5.Display.print(text); // M5GFX handles wrapping often, or needs manual implementation
    
    // Controls: Back, Gen Image
    M5.Display.fillRect(0, 500, 100, 40, TFT_LIGHTGREY);
    M5.Display.drawString("BACK", 20, 510, &fonts::FreeSans9pt7b);
    
    M5.Display.fillRect(800, 500, 150, 40, TFT_BLACK);
    M5.Display.setTextColor(TFT_WHITE, TFT_BLACK);
    M5.Display.drawString("GEN IMAGE", 810, 510, &fonts::FreeSans9pt7b);
}

void drawGallery(const std::vector<ImageFile>& images) {
    M5.Display.fillScreen(TFT_WHITE);
    // Grid layout for images
    int x = 20, y = 60;
    for(const auto& img : images) {
        // Thumbnail placeholder or small load
        M5.Display.drawRect(x, y, 150, 150, TFT_BLACK);
        M5.Display.drawString(img.originalFilename, x+5, y+70, &fonts::FreeSans9pt7b);
        x += 160;
        if(x > 800) { x = 20; y += 160; }
    }
    M5.Display.fillRect(0, 500, 100, 40, TFT_LIGHTGREY);
    M5.Display.setTextColor(TFT_BLACK, TFT_WHITE);
    M5.Display.drawString("BACK", 20, 510, &fonts::FreeSans9pt7b);
}

// ============================================================================
// MAIN SETUP & LOOP
// ============================================================================

void setup() {
    auto cfg = M5.config();
    M5.begin(cfg);
    Serial.begin(115200);

    // Init SD
    if(!SD.begin(GPIO_NUM_4, SPI, 25000000)) { // Verify pins for S3 Paper
        logError("SD Init Fail");
    }

    // Connect WiFi
    WiFi.begin(WIFI_SSID, WIFI_PASS);
    M5.Display.drawString("Connecting WiFi...", 10, 10);
    int attempts = 0;
    while (WiFi.status() != WL_CONNECTED && attempts < 20) {
        delay(500);
        attempts++;
    }
    if(WiFi.status() == WL_CONNECTED) M5.Display.drawString("WiFi Connected", 10, 30);

    scanFiles();
    drawMenu();
}

void loop() {
    M5.update();
    
    // Touch Logic
    if (M5.Touch.getCount() > 0) {
        auto t = M5.Touch.getDetail(0);
        if (t.wasPressed()) {
            if (currentState == STATE_MENU) {
                if (t.y > 40 && t.y < 120 && t.x > 50 && t.x < 250) {
                    startRecording();
                    currentState = STATE_RECORDING;
                }
                else if (t.y > 40 && t.y < 120 && t.x > 300 && t.x < 500) {
                    // Summaries
                    currentState = STATE_LIST_SUMMARIES;
                    std::vector<String> list;
                    for(auto s : recentSummaries) list.push_back(s.filename);
                    drawList("Recent Summaries", list);
                }
                else if (t.y > 140 && t.y < 220 && t.x > 300 && t.x < 500) {
                    currentState = STATE_GALLERY;
                    drawGallery(recentImages);
                }
            }
            else if (currentState == STATE_RECORDING) {
                stopRecording(); // Tap anywhere to stop
                drawMenu();
            }
            else if (currentState == STATE_LIST_SUMMARIES) {
                if (t.y > 500) { currentState = STATE_MENU; drawMenu(); }
                else {
                    // Simple hit test for list items (approx y / 60)
                    int idx = (t.y - 60) / 60;
                    if(idx >= 0 && idx < recentSummaries.size()) {
                         File f = SD.open(recentSummaries[idx].filename);
                         currentTextContent = f.readString();
                         f.close();
                         currentState = STATE_VIEW_SUMMARY;
                         drawTextView(currentTextContent);
                    }
                }
            }
            else if (currentState == STATE_VIEW_SUMMARY) {
                 if (t.y > 500 && t.x < 100) { currentState = STATE_LIST_SUMMARIES; /*redraw list*/ }
                 else if (t.y > 500 && t.x > 800) {
                     // Gen Image
                     M5.Display.fillScreen(TFT_WHITE);
                     M5.Display.drawString("Generating...", 400, 300);
                     String imgPath;
                     if(generateInfographic(currentTextContent, imgPath)) {
                         M5.Display.drawJpgFile(SD, imgPath.c_str());
                         scanFiles(); // update list
                         delay(3000);
                     }
                     drawMenu();
                     currentState = STATE_MENU;
                 }
            }
            else if (currentState == STATE_GALLERY) {
                if (t.y > 500) { currentState = STATE_MENU; drawMenu(); }
                // Hit test for images would go here
            }
        }
    }

    // Audio Loop
    if(currentState == STATE_RECORDING) {
        loopRecording();
    }
    
    delay(10);
}